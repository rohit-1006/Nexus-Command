# --- Nexus Command environment ---
# SQLite for development. For production point this at PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/nexus"
DATABASE_URL="file:./dev.db"

# Optional: real AI model keys. When absent, agents run in deterministic
# "simulated intelligence" mode with structured responses (Connector Honesty).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# OPENAI_MODEL="gpt-4o"
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# Demo / seed identity
OPERATOR_NAME="Jordan Reyes"
COMPANY_NAME="Northstar Systems"
COMPANY_TIMEZONE="America/New_York"

# SSRF-free demo webhook secret
WEBHOOK_SECRET="dev-local-secret"
