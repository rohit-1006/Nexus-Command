{
  "name": "nexus-command",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus Command — AI-native solo enterprise operating system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
